FROM fedora@sha256:0c1f63ed8fb818fad16cf6ae091598c410a21d2e1a9adf183beb93189299bfba

ARG GO_VERSION=1.26.5
ARG GO_SHA256=5c2c3b16caefa1d968a94c1daca04a7ca301a496d9b086e17ad77bb81393f053

RUN dnf install -y --setopt=install_weak_deps=False \
        ca-certificates \
        curl \
        file \
        glib2 \
        mingw64-adwaita-icon-theme-50.0-2.fc45 \
        mingw64-binutils-2.46.0-2.fc45 \
        mingw64-gcc-16.1.1-3.fc45 \
        mingw64-gdk-pixbuf-2.44.7-2.fc45 \
        mingw64-gtk4-4.22.2-3.fc45 \
        mingw64-librsvg2-2.62.3-2.fc45 \
        tar \
        zip \
    && curl -fsSLo /tmp/go.tgz \
        "https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz" \
    && printf '%s  %s\n' "$GO_SHA256" /tmp/go.tgz | sha256sum -c - \
    && tar -C /opt -xzf /tmp/go.tgz \
    && rm -f /tmp/go.tgz \
    && dnf clean all \
    && rm -rf /var/cache/dnf

# gotk4 v0.4.1 declares the legacy GIRepository package in one cgo preamble,
# but df-hud reaches no GIRepository symbols. Fedora's current MinGW GLib ships
# GIRepository 2.0, so provide only the dependency metadata that cgo asks for.
RUN mkdir -p /opt/pkgconfig \
    && printf '%s\n' \
        'Name: gobject-introspection-1.0-stub' \
        'Description: gotk4 compatibility stub; dependency is unused' \
        'Version: 1.86.0' \
        'Requires: glib-2.0 gobject-2.0' \
        'Libs:' \
        'Cflags:' \
        > /opt/pkgconfig/gobject-introspection-1.0.pc

ENV CC=/usr/bin/x86_64-w64-mingw32-gcc \
    CGO_ENABLED=1 \
    GOARCH=amd64 \
    GOOS=windows \
    GOTOOLCHAIN=local \
    MINGW_ROOT=/usr/x86_64-w64-mingw32/sys-root/mingw \
    OBJDUMP=/usr/bin/x86_64-w64-mingw32-objdump \
    PATH=/opt/go/bin:/usr/bin \
    PKG_CONFIG=/usr/bin/x86_64-w64-mingw32-pkg-config \
    PKG_CONFIG_PATH=/opt/pkgconfig \
    WINDRES=/usr/bin/x86_64-w64-mingw32-windres

WORKDIR /src

COPY windows-container-entrypoint.sh /usr/local/bin/windows-container-entrypoint
RUN chmod 0755 /usr/local/bin/windows-container-entrypoint

ENTRYPOINT ["/usr/local/bin/windows-container-entrypoint"]
